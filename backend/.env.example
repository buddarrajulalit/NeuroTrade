# NeuroTrade Spring Boot Backend Environment Variables

# Server Port (Render and container platforms automatically set PORT)
PORT=8080

# Database Configuration (PostgreSQL)
# Option A: Full JDBC URL (e.g. Render PostgreSQL or Neon / Supabase)
DATABASE_URL=jdbc:postgresql://localhost:5432/neurotrade
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Option B: Component properties (alternative for local setup)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=neurotrade
# DB_USER=postgres
# DB_PASSWORD=postgres

# Hibernate DDL Mode (use 'update' or 'validate' in production; never 'create-drop')
HIBERNATE_DDL_AUTO=update

# JWT Authentication
# Generate a strong 256-bit or 512-bit Base64-encoded secret for production
JWT_SECRET=NeuroTradeSecretKey2024!!VeryLongAndSecureBase64EncodedString
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXP_MS=604800000

# CORS Allowed Origins (comma-separated, without trailing slashes)
CORS_ORIGINS=https://neurotrade-iota.vercel.app,http://localhost:5173,http://localhost:3000

# AI Models (Optional - defaults to rule-based engine)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
