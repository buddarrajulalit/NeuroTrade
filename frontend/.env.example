# NeuroTrade Frontend Environment Variables

# Base URL of the deployed Spring Boot backend (MUST NOT be localhost in production)
# Example for local development:
VITE_API_BASE_URL=http://localhost:8080

# Example for production (set this in your Vercel Project Settings > Environment Variables):
# VITE_API_BASE_URL=https://neurotrade-backend.onrender.com

# Optional WebSocket URL override (defaults to ${VITE_API_BASE_URL}/ws if omitted)
# VITE_WS_URL=https://neurotrade-backend.onrender.com/ws
